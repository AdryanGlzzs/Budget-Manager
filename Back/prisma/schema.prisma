generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id         String   @id @default(uuid())
  name       String
  category   String
  date       DateTime
  amount     Decimal  @db.Decimal(10,2)
  color      String
  type       String
  status     Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Budget {
  id         String   @id @default(uuid())
  name       String
  color      String
  spent      Decimal  @db.Decimal(10,2)
  limit      Decimal  @db.Decimal(10,2)
  description String
  period     String   @default("monthly")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model savingGoals {
  id String  @id @default(uuid())
  name String
  target  Decimal  @db.Decimal(10,2)
  current Decimal  @db.Decimal(10,2)
  color  String
  deadline  String
}